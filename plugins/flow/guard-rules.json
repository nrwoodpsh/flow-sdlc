{
  "$schema-note": [
    "차단 목록의 **정본**이다. 이 파일 하나만 고친다.",
    "  guard-danger.sh   이 파일을 읽어 판정한다 (case 문에 열거하지 않는다)",
    "  hooks.test.sh     expect 를 읽어 케이스를 만든다 (손으로 적지 않는다)",
    "  README·CLAUDE.md  차단표를 이 파일에서 생성한다",
    "같은 목록이 셸 case 문과 산문 여러 곳에 복제되면 하나 늘리는 비용이 그만큼 된다.",
    "그러면 아무도 안 늘리고 미탐이 남는다.",
    "",
    "규칙 하나 늘리는 법: rules 에 한 줄, expect 에 최소 한 줄. 그게 전부다.",
    "expect 가 없는 규칙은 테스트가 실패시킨다 — 목록과 테스트가 어긋날 수 없다."
  ],
  "version": 1,

  "classes": {
    "irreversible": {
      "level": "block",
      "뜻": "되돌릴 수 없다 — 실행하면 복구 경로가 없거나 사람 손이 필요하다",
      "$note": "되돌릴 방법이 없는 것"
    },
    "defense-off": {
      "level": "block",
      "뜻": "다른 방어 층을 끈다 — AI 가 스스로 감시를 벗는 길이다",
      "$note": "AI 가 스스로 방어층을 끄는 길 — --no-verify · -c core.hooksPath="
    },
    "external-state": {
      "level": "block",
      "뜻": "우리 저장소 밖에 상태를 만든다 — 남이 보고 반응한다",
      "$note": "리포 밖에 흔적이 남는 것 — gh pr/issue/repo create · workflow run"
    },
    "judgement": {
      "level": "ask",
      "뜻": "판단이 갈린다 — 정상 작업일 때가 있어서 무조건 막으면 사람이 훅을 끈다",
      "$note": "등급이 하나면 '막거나 안 보거나' 둘뿐이다. 판단이 갈리는 것은 물어본다"
    }
  },

  "rules": [
    {
      "id": "git-push",
      "tool": "git", "words": "push", "class": "irreversible", "level": "block",
      "unless": "(^|[[:space:]])--dry-run([[:space:]]|$)",
      "label": "git push",
      "why": "원격 이력이 바뀐다 — 되돌리려면 남이 이미 받아 간 것을 고쳐야 한다.",
      "advice": "push·merge는 사람이 외부 툴로 합니다(Sourcetree 등). 커밋까지는 /flow:commit 이 합니다.",
      "note": "`-n` 은 보지 않는다 — `nice -n 10 git push` 의 `-n` 이 얹힌다. `--dry-run` 만 예외다."
    },
    {
      "id": "git-merge",
      "tool": "git", "words": "merge", "class": "irreversible", "level": "block",
      "unless": "(^|[[:space:]])--(abort|quit)([[:space:]]|$)",
      "label": "git merge",
      "why": "충돌 판단과 이력 결정이 사람 몫이다.",
      "advice": "머지는 사람이 합니다 — 충돌 판단과 이력 결정이 사람 몫입니다.",
      "note": "`--abort`·`--quit` 은 빠져나오는 것이라 통과. `--continue` 는 막는다 — 머지를 완료하고 이력을 다시 쓴다."
    },
    {
      "id": "git-rebase",
      "tool": "git", "words": "rebase", "class": "irreversible", "level": "block",
      "unless": "(^|[[:space:]])--(abort|quit|skip|show-current-patch)([[:space:]]|$)",
      "label": "git rebase",
      "why": "커밋 해시가 전부 바뀐다 — 이미 공유된 이력이면 되돌릴 수 없다.",
      "advice": "이력을 바꿉니다. 사람이 직접 하세요."
    },
    {
      "id": "git-filter-branch",
      "tool": "git", "words": "filter-branch", "class": "irreversible", "level": "block",
      "label": "git filter-branch",
      "why": "이력 전체를 다시 쓴다.",
      "advice": "이력을 파괴합니다. 사람이 직접 하세요."
    },
    {
      "id": "git-filter-repo",
      "tool": "git", "words": "filter-repo", "class": "irreversible", "level": "block",
      "label": "git filter-repo",
      "why": "이력 전체를 다시 쓴다.",
      "advice": "이력을 파괴합니다. 사람이 직접 하세요."
    },
    {
      "id": "git-reset-hard",
      "tool": "git", "words": "reset", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])--hard([[:space:]]|=|$)",
      "label": "git reset --hard",
      "why": "커밋되지 않은 변경은 어디에도 남지 않는다.",
      "advice": "커밋되지 않은 변경이 사라집니다. 되돌릴 수 없습니다."
    },
    {
      "id": "git-clean-force",
      "tool": "git", "words": "clean", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])(--force|-[a-zA-Z]*f[a-zA-Z]*)([[:space:]]|$)",
      "label": "git clean -f",
      "why": "추적되지 않는 파일은 git 이 사본을 갖고 있지 않다.",
      "advice": "추적되지 않는 파일이 사라집니다. 되돌릴 수 없습니다."
    },
    {
      "id": "git-pull-rebase",
      "tool": "git", "words": "pull", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])(--rebase|-r)([[:space:]]|$)",
      "label": "git pull --rebase",
      "why": "rebase 와 같은 일을 한다 — 이력을 다시 쓴다.",
      "advice": "이력을 바꿉니다. 사람이 직접 하세요."
    },
    {
      "id": "git-checkout-discard",
      "tool": "git", "words": "checkout", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])(--|--force|-f)([[:space:]]|$)",
      "label": "git checkout (변경 버림)",
      "why": "`checkout -- .` 는 reset --hard 와 같은 손실이다.",
      "advice": "커밋되지 않은 변경이 사라집니다. 되돌릴 수 없습니다."
    },
    {
      "id": "git-switch-discard",
      "tool": "git", "words": "switch", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])(--|--force|-f)([[:space:]]|$)",
      "label": "git switch (변경 버림)",
      "why": "`switch -f` 는 커밋 안 된 변경을 버리고 옮긴다.",
      "advice": "커밋되지 않은 변경이 사라집니다. 되돌릴 수 없습니다."
    },
    {
      "id": "git-restore",
      "tool": "git", "words": "restore", "class": "irreversible", "level": "block",
      "unless": "(^|[[:space:]])--staged([[:space:]]|$)",
      "label": "git restore",
      "why": "작업 트리를 되돌린다 — `--staged` 만 인덱스라 안전하다.",
      "advice": "커밋되지 않은 변경이 사라집니다. 되돌릴 수 없습니다."
    },
    {
      "id": "git-reflog-expire",
      "tool": "git", "words": "reflog", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])expire([[:space:]]|$)",
      "label": "git reflog expire",
      "why": "reflog 는 사고 뒤 되돌리는 마지막 안전망이다.",
      "advice": "되돌릴 안전망이 사라집니다."
    },
    {
      "id": "git-stash-clear",
      "tool": "git", "words": "stash", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])(clear|drop)([[:space:]]|$)",
      "label": "git stash clear/drop",
      "why": "스태시는 커밋이 아니라 지우면 찾을 곳이 없다.",
      "advice": "스태시가 사라집니다. 되돌릴 수 없습니다."
    },
    {
      "id": "git-update-ref-d",
      "tool": "git", "words": "update-ref", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])-d([[:space:]]|$)",
      "label": "git update-ref -d",
      "why": "참조가 사라지면 그 아래 커밋이 도달 불가가 된다.",
      "advice": "참조가 사라집니다."
    },
    {
      "id": "git-subtree-push",
      "tool": "git", "words": "subtree push", "class": "irreversible", "level": "block",
      "label": "git subtree push",
      "why": "원격을 바꾼다 — push 와 같다.",
      "advice": "원격을 바꿉니다. 사람이 외부 툴로 합니다."
    },

    {
      "id": "git-branch-force-delete",
      "tool": "git", "words": "branch", "class": "irreversible", "level": "block",
      "on": "rest", "caseSensitive": true,
      "when": "(^|[[:space:]])(-[a-zA-Z]*D[a-zA-Z]*|--delete[[:space:]]+--force|--force[[:space:]]+--delete)([[:space:]]|$)",
      "label": "git branch -D",
      "why": "머지되지 않은 커밋이 도달 불가가 된다 — `-d` 는 그때 거부하니 통과시킨다.",
      "advice": "미머지 커밋이 사라집니다. 지울 브랜치가 맞는지 사람이 확인하세요.",
      "note": "`-D`/`-d` 를 가르려면 대소문자를 구별해야 한다 — 그래서 caseSensitive. `on: rest` 라 명령 앞 래퍼의 `-D` 는 얹히지 않는다.",
      "diag": "실측 미탐 — 목록에 없어 통과했다"
    },
    {
      "id": "git-worktree-remove-force",
      "tool": "git", "words": "worktree remove", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])(--force|-[a-zA-Z]*f[a-zA-Z]*)([[:space:]]|$)",
      "label": "git worktree remove --force",
      "why": "미커밋 변경째로 워크트리를 지운다 — `--force` 없이는 git 이 거부하니 그건 통과시킨다.",
      "advice": "미커밋 변경이 사라집니다. 되돌릴 수 없습니다.",
      "diag": "실측 미탐 — 목록에 없어 통과했다"
    },
    {
      "id": "git-gc-prune",
      "tool": "git", "words": "gc", "class": "irreversible", "level": "block",
      "when": "(^|[[:space:]])--prune([[:space:]]|=|$)",
      "label": "git gc --prune",
      "why": "도달 불가 객체를 즉시 지운다 — reflog 로도 못 찾는다.",
      "advice": "되돌릴 객체가 사라집니다.",
      "diag": "실측 미탐 — 목록에 없어 통과했다"
    },

    {
      "id": "git-commit-no-verify",
      "tool": "git", "words": "commit", "class": "defense-off", "level": "block",
      "on": "rest",
      "when": "(^|[[:space:]])(--no-verify|-[a-zA-Z]*n[a-zA-Z]*)([[:space:]]|$)",
      "label": "git commit --no-verify",
      "why": "drift 훅을 끈다 — 문서가 낡은 채 커밋되고 다음 세션이 그걸 진실로 믿는다.",
      "advice": "훅을 끄지 말고 /flow:sync 로 문서를 맞추세요. 정말 넘겨야 하면 사람이 자기 터미널에서 합니다.",
      "note": "`on: rest` 여야 한다 — 세그먼트 전체를 보면 `nice -n 10 git commit` 의 `-n` 이 얹히고, 커밋 메시지 안의 `-n` 도 얹힌다. `-n` 은 commit 에서 --no-verify 의 짧은 이름이라 같이 막는다.",
      "diag": "커맨드가 자기 방어층을 끄는 자리다"
    },
    {
      "id": "git-hooks-off",
      "tool": "git", "words": "*", "class": "defense-off", "level": "block",
      "when": "(-c|--config-env)[[:space:]=]*core\\.hooksPath",
      "label": "git -c core.hooksPath=…",
      "why": "훅 폴더를 바꿔 drift 훅 자체를 없는 것으로 만든다 — --no-verify 보다 조용하다.",
      "advice": "훅을 끄지 마세요. 설정을 보려면 `git config --get core.hooksPath` 로 읽기만 하세요.",
      "note": "서브커맨드를 안 본다(words `*`) — `commit` 뿐 아니라 어떤 명령에 붙어도 훅이 꺼진다. 읽기(`git config --get core.hooksPath`)는 `-c` 형태가 아니라 통과한다.",
      "diag": "실측 미탐 — 목록에 없어 통과했다"
    },

    {
      "id": "gh-pr-merge",
      "tool": "gh", "words": "pr merge", "class": "irreversible", "level": "block",
      "label": "gh pr merge",
      "why": "머지는 사람의 판단이다.",
      "advice": "머지는 사람이 합니다 — 충돌 판단과 이력 결정이 사람 몫입니다."
    },
    {
      "id": "gh-release-create",
      "tool": "gh", "words": "release create", "class": "external-state", "level": "block",
      "label": "gh release create",
      "why": "태그와 릴리스가 원격에 남고 사람이 알림을 받는다.",
      "advice": "릴리스는 사람이 냅니다. 태그가 원격에 남습니다."
    },
    {
      "id": "gh-release-delete",
      "tool": "gh", "words": "release delete", "class": "irreversible", "level": "block",
      "label": "gh release delete",
      "why": "릴리스·태그가 원격에서 사라진다.",
      "advice": "릴리스·태그가 사라집니다."
    },
    {
      "id": "gh-repo-delete",
      "tool": "gh", "words": "repo delete", "class": "irreversible", "level": "block",
      "label": "gh repo delete",
      "why": "저장소가 사라진다.",
      "advice": "저장소가 사라집니다."
    },
    {
      "id": "gh-secret-set",
      "tool": "gh", "words": "secret set", "class": "irreversible", "level": "block",
      "label": "gh secret set",
      "why": "이전 값을 읽을 수 없어 되돌릴 수 없다.",
      "advice": "GitHub 상태를 바꿉니다. 사람이 직접 하세요."
    },
    {
      "id": "gh-variable-set",
      "tool": "gh", "words": "variable set", "class": "irreversible", "level": "block",
      "label": "gh variable set",
      "why": "CI 가 읽는 값을 바꾼다.",
      "advice": "GitHub 상태를 바꿉니다. 사람이 직접 하세요."
    },
    {
      "id": "gh-api-write-method",
      "tool": "gh", "words": "api", "class": "external-state", "level": "block",
      "when": "(-X|--method)[[:space:]=]*(POST|PUT|DELETE|PATCH)",
      "label": "gh api 쓰기",
      "why": "임의의 GitHub 상태를 바꾼다 — 무엇이 바뀔지 훅이 알 수 없다.",
      "advice": "GitHub 상태를 바꿉니다. 사람이 직접 하세요."
    },
    {
      "id": "gh-api-graphql-mutation",
      "tool": "gh", "words": "api graphql", "class": "external-state", "level": "block",
      "when": "mutation",
      "unless": "(-X|--method)[[:space:]=]*GET",
      "label": "gh api graphql mutation",
      "why": "GraphQL 읽기도 POST 라 메서드로는 못 가른다 — mutation 이라는 낱말로 가른다.",
      "advice": "GitHub 상태를 바꿉니다. 사람이 직접 하세요."
    },
    {
      "id": "gh-api-write-fields",
      "tool": "gh", "words": "api", "notWords": "api graphql", "class": "external-state", "level": "block",
      "when": "(^|[[:space:]])(-f|-F|--field|--raw-field|--input)([[:space:]=]|$)",
      "unless": "(-X|--method)[[:space:]=]*GET",
      "label": "gh api 쓰기(필드 플래그)",
      "why": "필드만 줘도 gh 가 POST 로 보낸다 — 메서드를 안 적어도 쓰기가 된다.",
      "advice": "필드를 주면 gh 가 POST 로 보냅니다. 사람이 직접 하세요.",
      "note": "검색·페이지네이션은 `-f` 가 유일한 방법이라 `-X GET` 을 못 박았으면 읽기로 본다. graphql 은 위 규칙이 따로 본다."
    },
    {
      "id": "gh-workflow-run",
      "tool": "gh", "words": "workflow run", "class": "external-state", "level": "block",
      "label": "gh workflow run",
      "why": "**배포가 돈다.** 훅이 막는 것 중 유일하게 저장소 밖 시스템을 건드린다.",
      "advice": "워크플로우 실행은 사람이 합니다. 무엇이 배포되는지 사람이 확인해야 합니다.",
      "diag": "실측 미탐 — 목록에 없어 통과했다"
    },
    {
      "id": "gh-pr-create",
      "tool": "gh", "words": "pr create", "class": "external-state", "level": "block",
      "label": "gh pr create",
      "why": "리뷰어에게 알림이 가고 GitHub 에 상태가 남는다.",
      "advice": "PR 은 사람이 엽니다 — 무엇을 리뷰 받을지가 사람의 판단입니다.",
      "diag": "실측 미탐 — 목록에 없어 통과했다"
    },
    {
      "id": "gh-issue-create",
      "tool": "gh", "words": "issue create", "class": "external-state", "level": "block",
      "label": "gh issue create",
      "why": "GitHub 에 외부 상태가 남고 사람이 알림을 받는다.",
      "advice": "이슈는 사람이 엽니다.",
      "diag": "실측 미탐 — 목록에 없어 통과했다"
    },
    {
      "id": "gh-repo-create",
      "tool": "gh", "words": "repo create", "class": "external-state", "level": "block",
      "label": "gh repo create",
      "why": "조직에 저장소가 생긴다 — 지우는 것도 사람 일이다.",
      "advice": "저장소는 사람이 만듭니다.",
      "diag": "실측 미탐 — 목록에 없어 통과했다"
    },

    {
      "id": "git-commit-amend",
      "tool": "git", "words": "commit", "class": "judgement", "level": "ask",
      "when": "(^|[[:space:]])--amend([[:space:]]|$)",
      "label": "git commit --amend",
      "why": "직전 커밋을 다시 쓴다 — 아직 push 안 했으면 정상 작업이고, 했으면 이력 사고다.",
      "advice": "아직 push 하지 않은 커밋이면 안전합니다. push 한 커밋이면 남의 이력과 갈라집니다.",
      "diag": "rebase 를 막으면서 이걸 빠뜨리기 쉽다"
    },
    {
      "id": "git-tag-delete",
      "tool": "git", "words": "tag", "class": "judgement", "level": "ask",
      "when": "(^|[[:space:]])(-d|--delete)([[:space:]]|$)",
